<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.spe</groupId>
  <artifactId>spe-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>spe-backend</name>
  <description>SPE 供应商绩效评估系统后端（Maven 单模块）</description>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.18.1</mybatis-plus.version>
    <jjwt.version>0.12.7</jjwt.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- Excel（01 E3）：4.0.3 是 2026-10 的稳定线；升级前先复跑导入的集成用例与 11 §5.3 的核对表 -->
    <easyexcel.version>4.0.3</easyexcel.version>
    <!--
      ⚠️ 必须显式钉住 commons-compress（04-091）：EasyExcel→POI 5.4 需要 ≥1.27 的
      putArchiveEntry(ZipArchiveEntry)，而 Testcontainers 传递进来的是 1.24.0；Maven 的就近原则会选 1.24.0，
      运行期直接 NoSuchMethodError（生成/读取 xlsx 时才炸，编译期完全看不出来）。
    -->
    <commons-compress.version>1.27.1</commons-compress.version>

    <!--
      Boot 4.1.2 起由 BOM 管理 Tomcat 11 / Jackson 3 / commons-lang3 / log4j2；
      原 Boot 3 的 tomcat.version、jackson-bom.version、commons-lang3.version、log4j2.version
      覆盖已删除（27 已实测旧 jackson-bom 属性会让 Boot 4 误解析 Jackson 3 BOM）。
      供应链处置记录见 03 §20 / 28 的 W4。
    -->
  </properties>

  <!--
    POI 5.4.1 覆盖（27 的评估结论）：EasyExcel 4.0.3 直接钉 poi/poi-ooxml 5.2.5，且没有版本属性可覆盖；
    5.2.5 有 1 条 MODERATE（CVE-2025-31672，修复于 5.4.0）。已在仓库外副本实测
    「POI 5.4.1 + EasyExcel 4.0.3」：导入/导出定向用例 16/16、后端全量 419/419 绿。
    之后升级 EasyExcel 或更换 Excel 库时，必须重新验证这三个坐标。
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi</artifactId>
        <version>5.4.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>5.4.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml-lite</artifactId>
        <version>5.4.1</version>
      </dependency>
      <!--
        POI 5.4.1 声明 commons-io 2.18.0；commons-compress 1.27.1（本项目直接依赖）传递 2.16.1，
        按就近原则压掉了 POI 的声明版本。收敛到 2.18.0，与 POI 的测试组合一致（仓库外探针的
        Excel 定向用例 16/16 绿）。
      -->
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.18.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Boot 4 模块化：Cache 自动配置不再位于核心；W0 实测缺此 starter 时 @EnableCaching 没有 CacheManager -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <!-- 指标暴露格式（03 §19）：actuator 自带 micrometer-core + SimpleMeterRegistry，
         但 Prometheus 抓取需要这个 registry 才有多文本格式的 /actuator/prometheus。
         版本随 Boot BOM，不手写（06 §8 第 20 条）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 持久层：MyBatis-Plus（Boot 4 starter）+ MySQL 8.4 + Flyway（Boot 4 需 starter-flyway 提供自动配置） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- Excel：导入模板下载 + 任务级批量导入（01 E3/E17）。版本钉在 properties（09 D2 的版本基线） -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>easyexcel</artifactId>
      <version>${easyexcel.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>${commons-compress.version}</version>
    </dependency>

    <!-- JWT：0.12.x 的 builder/parser 链 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 的 TestRestTemplate 自动配置需要 RestTemplateBuilder（spring-boot-restclient） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 6 配套：ArchUnit 1.5.x 的 JUnit 6 引擎是独立坐标 archunit-junit6 -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit6</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试设施（10 §E6 / 09 D7）：版本随 Boot BOM，起 mysql:8.4（与 compose 同镜像） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
