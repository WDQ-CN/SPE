<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.spe</groupId>
  <artifactId>spe-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>spe-backend</name>
  <description>SPE 供应商绩效评估系统后端（Maven 单模块）</description>

  <properties>
    <java.version>17</java.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <jjwt.version>0.12.7</jjwt.version>
    <archunit.version>1.5.0</archunit.version>
    <!-- Excel（01 E3）：4.0.3 是 2026-10 的稳定线；升级前先复跑导入的集成用例与 11 §5.3 的核对表 -->
    <easyexcel.version>4.0.3</easyexcel.version>
    <!--
      ⚠️ 必须显式钉住 commons-compress（04-091）：EasyExcel→POI 5.4 需要 ≥1.27 的
      putArchiveEntry(ZipArchiveEntry)，而 Testcontainers 传递进来的是 1.24.0；Maven 的就近原则会选 1.24.0，
      运行期直接 NoSuchMethodError（生成/读取 xlsx 时才炸，编译期完全看不出来）。
    -->
    <commons-compress.version>1.27.1</commons-compress.version>

    <!-- 供应链核对（03 §20 / P5-W4）发现的升级项。除 commons-lang3 外都由 Spring Boot BOM 管理，
         这里用 Boot 认可的属性覆盖到**同一补丁线**内的修复版本（只动补丁位，不跨次版本）：
           - tomcat-embed-core 10.1.55 → 10.1.59：3 个 CRITICAL（DIGEST 认证重放绕过、访问控制、
             FORM 认证授权）。**不能写 10.1.58**——OSV 报的修复版本是它，但该版本在 Maven Central 上
             不存在（目录 404，被跳过/撤回），10.1.59 是修复点之后第一个可用版本，故取它。
           - jackson 2.21.5 → 2.21.7（P5，2026-10-24）：OSV 新收录 5 条 HIGH（core ReDoS/无界 StringBuilder、
             databind 多个反序列化绕过）；2.21.7 是 2.21 线的修复版。
           - commons-lang3 3.17.0 → 3.18.0（P5，2026-10-24）：1 条 MODERATE（超长输入递归）；Boot 3.5.16
             的 BOM 管理 3.17.0，这里用属性覆盖到 3.18.0（次版本，需全量回归）。
           - log4j-api 2.24.3 → 2.25.5：1 个 MODERATE（MapMessage 的 JSON 序列化对非有限浮点数编码不当）
         升级后复跑全量测试与端到端，处置记录见 03 §20 / 20 §7。 -->
    <tomcat.version>10.1.59</tomcat.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <log4j2.version>2.25.5</log4j2.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 指标暴露格式（03 §19）：actuator 自带 micrometer-core + SimpleMeterRegistry，
         但 Prometheus 抓取需要这个 registry 才有多文本格式的 /actuator/prometheus。
         版本随 Boot BOM，不手写（06 §8 第 20 条）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 持久层：MyBatis-Plus（Boot 3 starter）+ MySQL 8.4 + Flyway -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- Excel：导入模板下载 + 任务级批量导入（01 E3/E17）。版本钉在 properties（09 D2 的版本基线） -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>easyexcel</artifactId>
      <version>${easyexcel.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>${commons-compress.version}</version>
    </dependency>

    <!-- JWT：0.12.x 的 builder/parser 链 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试设施（10 §E6 / 09 D7）：版本随 Boot BOM，起 mysql:8.4（与 compose 同镜像） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
